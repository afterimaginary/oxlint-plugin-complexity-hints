{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.mjs"],
						"statusMessage": "Fixing, formatting and linting the edited file"
					}
				]
			},
			{
				"matcher": "Edit|Write|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": ["${CLAUDE_PROJECT_DIR}/src/checker/cli.ts", "--claude-code-hook"],
						"statusMessage": "Checking the change's cognitive complexity"
					}
				]
			}
		]
	}
}
