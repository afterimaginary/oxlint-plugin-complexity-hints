{
	"name": "complexity-plugin-oxlint",
	"version": "0.0.0",
	"description": "Cognitive complexity rule for Oxlint, with single-line diagnostics aimed at AI coding agents",
	"keywords": [
		"cognitive-complexity",
		"complexity",
		"lint",
		"oxlint",
		"oxlint-plugin"
	],
	"homepage": "https://github.com/afterimaginary/complexity-plugin-oxlint#readme",
	"bugs": {
		"url": "https://github.com/afterimaginary/complexity-plugin-oxlint/issues"
	},
	"license": "MIT",
	"author": "afterimaginary",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/afterimaginary/complexity-plugin-oxlint.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"test": "vp test",
		"prepublishOnly": "vp run build",
		"prepare": "vp config",
		"ready": "vp check && vp test",
		"verify": "vp run ready && vp run build"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.83.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.5",
		"@typescript-eslint/parser": "8.72.0",
		"@typescript/native-preview": "npm:typescript@^7.0.2",
		"bumpp": "^12.3.0",
		"eslint": "10.13.0",
		"eslint-plugin-sonarjs": "4.2.2",
		"oxlint": "1.83.0",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"oxlint": ">=1.83.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.15.0",
			"onFail": "download"
		}
	},
	"inlinedDependencies": {
		"@oxlint/plugins": "1.83.0"
	}
}
