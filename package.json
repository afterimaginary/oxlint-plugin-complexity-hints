{
	"name": "oxlint-plugin-complexity-hints",
	"version": "0.0.0",
	"description": "Keep code written by coding agents easy to review: an Oxlint cognitive complexity rule with single-line fix hints, and a checker that keeps them within the change",
	"keywords": [
		"ai",
		"claude-code",
		"code-quality",
		"code-review",
		"coding-agents",
		"cognitive-complexity",
		"complexity",
		"lint",
		"linter",
		"oxlint",
		"oxlint-plugin",
		"sonarjs"
	],
	"homepage": "https://github.com/afterimaginary/oxlint-plugin-complexity-hints#readme",
	"bugs": {
		"url": "https://github.com/afterimaginary/oxlint-plugin-complexity-hints/issues"
	},
	"license": "MIT",
	"author": "afterimaginary",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/afterimaginary/oxlint-plugin-complexity-hints.git"
	},
	"bin": {
		"complexity-hints": "./dist/checker/cli.mjs"
	},
	"files": [
		"dist",
		"recommended.json"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./recommended": "./dist/recommended.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"test": "vp test",
		"prepublishOnly": "vp run build",
		"prepare": "vp config",
		"ready": "vp check && vp test",
		"verify": "vp run ready && vp run build && node scripts/check-package.mjs && node scripts/smoke-dist.mjs",
		"evaluate-hints": "node scripts/evaluate-hints.mjs && vp fmt docs/evaluation/hints.md",
		"simulate-hints": "node scripts/simulate-hints.mjs && vp fmt docs/evaluation/strategies.md"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.83.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.6.5",
		"@typescript-eslint/parser": "8.72.0",
		"@typescript/native-preview": "npm:typescript@^7.0.2",
		"eslint": "10.13.0",
		"eslint-plugin-sonarjs": "4.2.2",
		"fast-check": "^4.10.2",
		"oxlint": "1.83.0",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"oxlint": ">=1.83.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.15.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"inlinedDependencies": {
		"@oxlint/plugins": "1.83.0"
	}
}
